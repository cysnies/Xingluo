---
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath, stripBase } from "@/utils/withBase";
import Favicon from "@/components/Favicon.astro";
import { LOCALES, DEFAULT_LOCALE } from "@/i18n";
import { parseLocaleFromPath } from "@/i18n/routing";
import config from "@/config";
import { getSiteTitle, getSiteDescription } from "@/utils/siteBrand";
import FontLinks from "@/components/fonts/FontLinks.astro";
import { resolveActiveFont, getFontCatalog } from "@/fonts/resolve";
import { toClientFontEntry, FONT_CATALOG_SCRIPT_ID, FONT_STORAGE_KEY, FONT_LINK_ATTR } from "@/fonts/client";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { site } = config;
const currentLocale = Astro.currentLocale ?? site.lang;

const {
  title = getSiteTitle(currentLocale),
  description = getSiteDescription(currentLocale),
  ogImage = resolveDefaultOgImagePath(),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getRelativeLocaleUrl(currentLocale, "rss.xml");

const activeFont = resolveActiveFont();
const fontCatalogJson = JSON.stringify(getFontCatalog().map(toClientFontEntry));
const palette = config.features.palette ?? "zinc";
const accent = config.features.accent ?? "none";
const uiStyle = config.features.uiStyle ?? "new-york";
const foucScript = `(function(){try{var raw=document.getElementById(${JSON.stringify(FONT_CATALOG_SCRIPT_ID)});if(!raw||!raw.textContent)return;var catalog=JSON.parse(raw.textContent);var id=localStorage.getItem(${JSON.stringify(FONT_STORAGE_KEY)});var entry=catalog.find(function(f){return f.id===id;})||catalog.find(function(f){return f.id===document.documentElement.getAttribute("data-font");});if(!entry)return;var root=document.documentElement;root.style.setProperty("--font-sans",entry.stack);if(entry.monoStack)root.style.setProperty("--font-mono",entry.monoStack);root.setAttribute("data-font",entry.id);if(entry.source!=="system"&&entry.cssUrl){var link=document.createElement("link");link.rel="stylesheet";link.href=entry.cssUrl;link.setAttribute(${JSON.stringify(FONT_LINK_ATTR)},"1");document.head.appendChild(link);}}catch(e){}})();`;

const fontStyle = [
  `--font-sans: ${activeFont.stack}`,
  activeFont.monoStack ? `--font-mono: ${activeFont.monoStack}` : null,
]
  .filter(Boolean)
  .join("; ");

/**
 * 计算当前页面各语言版本的 URL，用于 hreflang alternate 链接。
 * 默认语言无前缀，其他语言带前缀；路径保持一致。
 */
const { path: localeAgnosticPath } = parseLocaleFromPath(
  stripBase(Astro.url.pathname)
);
const normalizedPath =
  localeAgnosticPath === "/" || localeAgnosticPath === ""
    ? undefined
    : localeAgnosticPath.replace(/^\/+|\/+$/g, "") || undefined;
const alternateLinks = LOCALES.map((target) => ({
  hreflang: target,
  href: new URL(
    getRelativeLocaleUrl(target, normalizedPath),
    Astro.site
  ).href,
}));
// x-default 指向默认语言版本，供未匹配语言的用户入口
const defaultAlternate = {
  hreflang: "x-default",
  href: new URL(
    getRelativeLocaleUrl(DEFAULT_LOCALE, normalizedPath),
    Astro.site
  ).href,
};
---

<!doctype html>
<html
  dir={site.dir}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
  data-animations={JSON.stringify(config.features.animations)}
  data-font={activeFont.id}
  data-palette={palette}
  data-accent={accent === "none" ? undefined : accent}
  data-ui-style={uiStyle}
  style={fontStyle}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontLinks />
    <script
      is:inline
      type="application/json"
      id={FONT_CATALOG_SCRIPT_ID}
      set:html={fontCatalogJson}
    />
    <!-- 字体 FOUC：在绘制前应用 localStorage 选择并按需注入 CSS -->
    <script is:inline set:html={foucScript} />
    <Favicon favicon={site.favicon!} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- 主要 meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={getSiteTitle(currentLocale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS 自动发现 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={getSiteTitle(currentLocale)}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- hreflang 多语言版本声明，供搜索引擎理解各语言对应关系 -->
    {
      alternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" hreflang={defaultAlternate.hreflang} href={defaultAlternate.href} />

    <!-- 运行时由 theme.ts 填充为当前背景色 -->
    <meta name="theme-color" content="" />

    <!-- 子布局注入的额外 head 内容（如 JSON-LD、文章 meta） -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta name="google-site-verification" content={site.googleVerification} />
      )
    }

    <!--
      内联 FOUC 防护脚本：在浏览器绘制前设置 <html> 的 data-theme
      同步执行，无 defer/async
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        window.__theme = { value: theme };
      })();
    </script>

    {
      config.features.viewTransitions !== false && <ClientRouter />
    }
  </head>
  <body
    class="bg-background text-foreground app-layout"
    data-animations-toc={config.features.animations.tocSmooth}
    data-animations-theme={config.features.animations.themeTransition}
  >
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
    {
      /* 动画模块入口 */
      (config.features.animations.spotlightCard ||
        config.features.animations.scrollReveal ||
        config.features.animations.navIndicator) && (
        <script>
          import "@/scripts/animations";
        </script>
      )
    }
  </body>
</html>
