---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Socials from "@/components/Socials.astro";
import PostCard from "@/components/PostCard.astro";
import FeaturedPosts from "@/components/post/FeaturedPosts.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getPostsForLocale } from "@/utils/i18nPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getSiteTitle, getSiteDescription } from "@/utils/siteBrand";
import { getAssetPath } from "@/utils/withBase";
import ArrowRight from "@/assets/icons/ArrowRight.astro";
import Rss from "@/assets/icons/Rss.astro";
import { getPostHeroSources } from "@/utils/postHeroImage";

const { site, posts: postsConfig } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const avatar = site.avatar || undefined;
const avatarSrc = avatar?.src.trim();
const avatarUrl =
  avatarSrc &&
  (/^(?:https?:)?\/\//i.test(avatarSrc) ? avatarSrc : getAssetPath(avatarSrc));
const avatarShape = {
  square: "rounded-none",
  rounded: "rounded-2xl",
  circle: "rounded-full",
}[avatar?.shape ?? "circle"];

const posts = await getCollection("posts");
const sortedPosts = getPostsForLocale(posts, locale);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const visibleFeaturedPosts =
  featuredPosts.length >= 7 ? featuredPosts.slice(0, 4) : featuredPosts;
const visibleRecentPosts = recentPosts.slice(0, postsConfig.perIndex);

function getRawPostHero(post: (typeof sortedPosts)[number] | undefined) {
  if (!post || !config.features.showPostCardHero) return undefined;
  return post.data.heroImage;
}

const priorityPost = [...visibleFeaturedPosts, ...visibleRecentPosts].find(
  (post) => Boolean(getRawPostHero(post)),
);
const rawPriorityHero = getRawPostHero(priorityPost);
const priorityHeroSources =
  rawPriorityHero && typeof rawPriorityHero === "object"
    ? await getPostHeroSources(rawPriorityHero)
    : undefined;
const priorityHeroSrc =
  priorityHeroSources?.src ??
  (typeof rawPriorityHero === "string" ? rawPriorityHero : undefined);
const priorityHeroIsRemote =
  priorityHeroSrc &&
  (/^https?:\/\//i.test(priorityHeroSrc) ||
    priorityHeroSrc.startsWith("//"));
const priorityHeroUrl = priorityHeroSrc
  ? priorityHeroSrc.startsWith("//")
    ? `https:${priorityHeroSrc}`
    : /^https?:\/\//i.test(priorityHeroSrc)
      ? priorityHeroSrc
      : priorityHeroSrc.startsWith("/")
        ? priorityHeroSrc
        : new URL(priorityHeroSrc, Astro.site ?? Astro.url).href
  : undefined;
const priorityHeroOrigin = priorityHeroIsRemote
  ? new URL(priorityHeroUrl!).origin
  : undefined;
const allPostsHref = getRelativeLocaleUrl(locale, "posts");
// 直接构建 RSS URL，不通过 getRelativeLocaleUrl（该函数会附加尾部斜杠且为非默认语言添加前缀），
// 因为 RSS 端点仅存在于根级别 src/pages/rss.xml.ts，不受语言路由影响。
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const rssHref = new URL(
  `${base}/rss.xml`,
  Astro.site ?? Astro.url
).href;
---

<Layout>
  {
    priorityHeroUrl && (
      <Fragment slot="head">
        <link rel="preconnect" href={priorityHeroOrigin} />
        <link
          rel="preload"
          as="image"
          href={priorityHeroUrl}
          fetchpriority="high"
          media={
            config.features.showPostCardHeroMobile
              ? undefined
              : "(min-width: 768px)"
          }
        />
      </Fragment>
    )
  }
  <Header />
  <Main fullWidth>
    <!-- Hero 区域 -->
    <section class="home-section" data-reveal>
      <div class="home-section-content site-frame py-4 sm:py-5">
        <div class:list={[avatarUrl ? "grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-x-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-6" : "block"]}>
          {avatarUrl && (
            <img
              src={avatarUrl}
              alt={avatar?.alt ?? getSiteTitle(locale)}
              width="160"
              height="160"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class:list={[
                "size-18 shrink-0 object-cover sm:size-40",
                avatarShape,
              ]}
            />
          )}
          <div class="contents sm:block sm:min-w-0">
            <div class="flex min-w-0 items-center gap-2 sm:gap-3">
              <h1 class="min-w-0 break-words text-3xl font-bold tracking-tight sm:my-6 sm:text-5xl motion-safe:animate-fade-in-down">
                {getSiteTitle(locale)}
              </h1>
              <a
                href={rssHref}
                class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                aria-label={t.nav.rss}
                title="RSS"
              >
                <Rss class="size-5" />
                <span class="sr-only">RSS</span>
              </a>
            </div>
            <p class="col-span-2 mt-4 max-w-prose text-base leading-relaxed text-muted-foreground sm:mt-0 sm:text-lg">{getSiteDescription(locale)}</p>
            {
              config.features.showHomeSocials && config.socials.length > 0 && (
                <div class="col-span-2 mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 [&_a]:size-11 sm:mt-6 sm:[&_a]:size-9">
                  <span class="whitespace-nowrap text-sm text-muted-foreground">
                    {t.home.socialLinks}:
                  </span>
                  <Socials />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 精选文章 -->
    {
      featuredPosts.length > 0 && (
        <section class="home-section" data-reveal>
          <div class="home-section-content site-frame py-4 sm:py-5">
            <h2 class="mb-4 text-2xl font-semibold tracking-tight">
              {t.home.featured}
            </h2>
            <FeaturedPosts
              posts={visibleFeaturedPosts}
              priorityPostId={priorityPost?.id}
            />
          </div>
        </section>
      )
    }

    <!-- 最新文章 -->
    {
      recentPosts.length > 0 && (
        <section class="home-section">
          <div class="home-section-content site-frame py-4 sm:py-5">
            <h2 class="mb-4 text-2xl font-semibold tracking-tight">
              {t.home.recentPosts}
            </h2>
            <ul data-latest-posts class="grid gap-5">
              {visibleRecentPosts.map((post) => (
                <li class="min-w-0">
                  <PostCard
                    post={post}
                    priority={post.id === priorityPost?.id}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- 查看全部文章 -->
    <div class="home-section">
      <div class="home-section-content site-frame py-4 text-center">
        <LinkButton href={allPostsHref} variant="outline" size="lg">
          {t.home.allPosts}
          <ArrowRight class="size-4 rtl:-rotate-180" />
        </LinkButton>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  .home-section-content {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--frame-gutter);
  }

</style>
