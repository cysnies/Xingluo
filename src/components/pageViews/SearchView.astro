---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const title = t.pages.searchTitle;
const description = t.pages.searchDesc;
const crumbs = [
  { href: getRelativeLocaleUrl(locale), label: t.nav.home },
  { label: title },
];
---

<Layout title={title} description={description}>
  <Header />
  <Main>
    <Breadcrumb items={crumbs} class="mb-6" />
    <h1 class="mb-6 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mb-8 text-muted-foreground">{description}</p>

    <div id="flexsearch-ui" transition:persist class="space-y-6">
      <!-- 搜索输入框 -->
      <div class="relative">
        <svg
          class="search-icon absolute left-3 top-1/2 size-5 -translate-y-1/2 text-muted-foreground"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder={t.a11y.searchPlaceholder}
          class="search-input w-full rounded-md border border-input bg-background py-3 pl-10 pr-10 text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
        />
        <button
          id="search-clear"
          class="search-clear absolute right-3 top-1/2 hidden -translate-y-1/2 text-muted-foreground transition-colors hover:text-foreground"
          aria-label={t.a11y.clearSearch}
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>

      <!-- 搜索统计 -->
      <div
        id="search-stats"
        class="hidden text-sm text-muted-foreground"
        aria-live="polite"
        data-results-tpl={t.a11y.searchResultsCount}
      ></div>

      <!-- 搜索结果列表 -->
      <div id="search-results" class="space-y-4" role="list" aria-label={t.pages.searchTitle}>
        <!-- 初始提示 -->
        <div id="search-hint" class="py-12 text-center text-muted-foreground">
          <svg
            class="mx-auto mb-4 size-12 opacity-40"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <p>{t.a11y.searchPlaceholder}</p>
        </div>
        <!-- 无结果提示（由 JS 控制显示） -->
        <div id="search-no-results" class="hidden py-12 text-center text-muted-foreground">
          <p>{t.a11y.noResults}</p>
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import { initSearch } from "@/scripts/searchClient";
  initSearch();
  document.addEventListener("astro:after-swap", () => initSearch());
</script>

<style is:global>
  /* 搜索图标颜色 */
  #flexsearch-ui .search-icon {
    pointer-events: none;
  }

  /* 清除按钮在输入框有内容时显示 */
  #flexsearch-ui .search-clear {
    display: none;
  }

  /* 搜索结果卡片入场动画 */
  #flexsearch-ui .search-result-card.search-result-enter {
    animation: search-result-in 0.28s ease-out both;
  }
  @keyframes search-result-in {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 高亮关键词 */
  #flexsearch-ui .search-highlight {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-radius: 2px;
    padding: 0 2px;
  }

  /* 结果卡片字号 */
  #flexsearch-ui .search-result-card h3 {
    line-height: 1.4;
  }

</style>
