---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getPostsForLocale } from "@/utils/i18nPosts";
import { groupPostsByYearMonth } from "@/utils/getPostsByGroupCondition";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";
import dayjs from "@/lib/dayjs";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const timezone = config.site.timezone;

const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const posts = await getCollection("posts");
const sortedPosts = getPostsForLocale(posts, locale);

const yearGroups = groupPostsByYearMonth(sortedPosts, (post) =>
  dayjs(post.data.pubDatetime).tz(timezone).toDate(),
);

const currentYear = dayjs().tz(timezone).year();

const title = t.pages.archivesTitle;
const description = t.pages.archivesDesc;
const crumbs = [
  { href: getRelativeLocaleUrl(locale), label: t.nav.home },
  { label: title },
];
---

<Layout title={title} description={description}>
  <Header />
  <Main>
    <Breadcrumb items={crumbs} class="mb-6" />
    <h1 class="mb-6 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mb-8 text-muted-foreground">{description}</p>

    {/* 紧凑时间线：避免每篇 PostCard 撑大 HTML；当年默认展开，往年折叠 */}
    <div class="space-y-4">
      {
        yearGroups.map((yearGroup) => {
          const open = yearGroup.year === currentYear;
          return (
            <details
              class="group rounded-lg border border-border bg-card open:shadow-sm"
              open={open || undefined}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-lg font-semibold tracking-tight marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-2">
                  {yearGroup.year}
                  <sup class="text-sm font-normal text-muted-foreground">
                    {tplStr(t.archives.postCount, {
                      count: String(yearGroup.posts.length),
                    })}
                  </sup>
                </span>
                <span
                  class="text-muted-foreground transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </summary>
              <div class="space-y-6 border-t border-border px-4 py-4">
                {yearGroup.months.map((monthGroup) => (
                  <div>
                    <h3 class="mb-2 flex items-center gap-2 text-sm font-medium text-muted-foreground">
                      {tplStr(t.archives.monthLabel, {
                        month: String(monthGroup.month),
                      })}
                      <span class="text-xs font-normal">
                        {tplStr(t.archives.postCount, {
                          count: String(monthGroup.posts.length),
                        })}
                      </span>
                    </h3>
                    <ul class="divide-y divide-border rounded-md border border-border">
                      {monthGroup.posts.map((post) => {
                        const href = getPostUrl(post.id, post.filePath, locale);
                        const dateStr = dayjs(post.data.pubDatetime)
                          .tz(post.data.timezone ?? timezone)
                          .format("MM-DD");
                        return (
                          <li>
                            <a
                              href={href}
                              class="flex items-baseline justify-between gap-3 px-3 py-2.5 text-sm transition-colors hover:bg-accent/40"
                            >
                              <span class="min-w-0 truncate font-medium text-foreground">
                                {post.data.title}
                              </span>
                              <time
                                class="shrink-0 tabular-nums text-xs text-muted-foreground"
                                datetime={dayjs(post.data.pubDatetime).toISOString()}
                              >
                                {dateStr}
                              </time>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          );
        })
      }
    </div>
  </Main>
  <Footer />
</Layout>
