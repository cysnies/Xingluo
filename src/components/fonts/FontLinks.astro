---
/**
 * 按 fonts 配置注入当前字体的 stylesheet（cdn / local）
 * system 不发网络请求；一次只启用一项，避免默认拉全量 CJK 巨包
 */
import { resolveActiveFont, maybeMirrorCssUrl } from "@/fonts/resolve";
import { getAssetPath } from "@/utils/withBase";

const font = resolveActiveFont();
const rawCssUrls =
  font.source === "system"
    ? []
    : (font.cssUrls ?? (font.cssUrl ? [font.cssUrl] : []));
const cssUrls = rawCssUrls.map((cssUrl) =>
  /^https?:\/\//i.test(cssUrl)
    ? maybeMirrorCssUrl(cssUrl)
    : getAssetPath(cssUrl),
);

const preconnectOrigins = new Set(font.preconnectOrigins ?? []);
for (const cssUrl of cssUrls) {
  if (!/^https?:\/\//i.test(cssUrl)) continue;
  try {
    preconnectOrigins.add(new URL(cssUrl).origin);
  } catch {}
}
---

{
  cssUrls.length > 0 && (
    <>
      {[...preconnectOrigins].map((origin) => (
        <link rel="preconnect" href={origin} crossorigin />
      ))}
      {cssUrls.map((cssUrl) => (
        <>
          <link
            rel="preload"
            as="style"
            href={cssUrl}
            fetchpriority="high"
          />
          <link
            rel="stylesheet"
            href={cssUrl}
            media="print"
            onload={"this.media='all'"}
            fetchpriority="low"
            data-xingluo-font-link="1"
          />
        </>
      ))}
      <noscript>
        {cssUrls.map((cssUrl) => (
          <link rel="stylesheet" href={cssUrl} data-xingluo-font-link="1" />
        ))}
      </noscript>
    </>
  )
}

<meta name="xingluo-font" content={font.id} />
