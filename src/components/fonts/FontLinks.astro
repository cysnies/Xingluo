---
/**
 * 按 fonts 配置注入当前字体的 stylesheet（cdn / local）
 * system 不发网络请求；一次只启用一项，避免默认拉全量 CJK 巨包
 */
import { resolveActiveFont, maybeMirrorCssUrl } from "@/fonts/resolve";

const font = resolveActiveFont();
const rawCssUrls =
  font.source === "system"
    ? []
    : (font.cssUrls ?? (font.cssUrl ? [font.cssUrl] : []));
const cssUrls = rawCssUrls.map(maybeMirrorCssUrl);

let cssOrigin: string | undefined;
if (cssUrls[0] && /^https?:\/\//i.test(cssUrls[0])) {
  try {
    cssOrigin = new URL(cssUrls[0]).origin;
  } catch {
    cssOrigin = undefined;
  }
}
---

{
  cssUrls.length > 0 && (
    <>
      {cssOrigin && <link rel="preconnect" href={cssOrigin} crossorigin />}
      {cssUrls.map((cssUrl) => (
        <link
          rel="stylesheet"
          href={cssUrl}
          media="print"
          onload={"this.media='all'"}
          fetchpriority="low"
          data-xingluo-font-link="1"
        />
      ))}
      <noscript>
        {cssUrls.map((cssUrl) => (
          <link rel="stylesheet" href={cssUrl} data-xingluo-font-link="1" />
        ))}
      </noscript>
    </>
  )
}

<meta name="xingluo-font" content={font.id} />
