---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";
import Card from "@/components/ui/Card.astro";
import ArrowLeft from "@/assets/icons/ArrowLeft.astro";
import ArrowRight from "@/assets/icons/ArrowRight.astro";

interface Props {
  prevPost?: CollectionEntry<"posts">;
  nextPost?: CollectionEntry<"posts">;
}

const { prevPost, nextPost } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;
---

<nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label={t.a11y.adjacentPosts}>
  {
    prevPost ? (
      <Card class="group h-full gap-0 rounded-xl border-border/80 p-0 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/20 motion-reduce:transition-none">
        <a
          href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
          class="flex min-h-40 flex-col justify-between gap-8 p-6 focus-visible:outline-none"
        >
          <span class="flex min-w-0 items-start gap-3">
            <span class="min-w-0 flex-1">
              <span class="block text-xs text-muted-foreground">{t.post.previousPost}</span>
              <span class="mt-2 block line-clamp-2 break-words text-xl leading-[1.4] font-semibold">
                {prevPost.data.title}
              </span>
            </span>
            <ArrowLeft class="mt-1.5 size-4 shrink-0 text-muted-foreground transition-transform duration-200 motion-safe:group-hover:-translate-x-0.5" />
          </span>
        </a>
      </Card>
    ) : (
      <div class="hidden sm:block" />
    )
  }
  {
    nextPost ? (
      <Card class="group h-full gap-0 rounded-xl border-border/80 p-0 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/20 sm:col-start-2 motion-reduce:transition-none">
        <a
          href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
          class="flex min-h-40 flex-col justify-between gap-8 p-6 focus-visible:outline-none"
        >
          <span class="flex min-w-0 items-start gap-3">
            <span class="min-w-0 flex-1">
              <span class="block text-xs text-muted-foreground">{t.post.nextPost}</span>
              <span class="mt-2 block line-clamp-2 break-words text-xl leading-[1.4] font-semibold">
                {nextPost.data.title}
              </span>
            </span>
            <ArrowRight class="mt-1.5 size-4 shrink-0 text-muted-foreground transition-transform duration-200 motion-safe:group-hover:translate-x-0.5" />
          </span>
        </a>
      </Card>
    ) : null
  }
</nav>
