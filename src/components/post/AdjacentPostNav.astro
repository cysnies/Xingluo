---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";
import Card from "@/components/ui/Card.astro";

interface Props {
  prevPost?: CollectionEntry<"posts">;
  nextPost?: CollectionEntry<"posts">;
}

const { prevPost, nextPost } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;
---

<nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label={t.a11y.adjacentPosts}>
  {
    prevPost ? (
      <Card class="h-full gap-0 rounded-xl border-border/80 p-0 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/20 motion-reduce:transition-none">
        <a
          href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
          data-adjacent-direction="previous"
          class="flex min-h-24 flex-col justify-center gap-2 p-6 focus-visible:outline-none"
        >
          <span class="block text-xs text-muted-foreground">{t.post.previousPost}</span>
          <span class="block line-clamp-2 break-words text-xl leading-[1.4] font-semibold">
            {prevPost.data.title}
          </span>
        </a>
      </Card>
    ) : (
      <div class="hidden sm:block" />
    )
  }
  {
    nextPost ? (
      <Card class="h-full gap-0 rounded-xl border-border/80 p-0 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/20 sm:col-start-2 motion-reduce:transition-none">
        <a
          href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
          data-adjacent-direction="next"
          class="flex min-h-24 flex-col justify-center gap-2 p-6 focus-visible:outline-none"
        >
          <span class="block text-xs text-muted-foreground">{t.post.nextPost}</span>
          <span class="block line-clamp-2 break-words text-xl leading-[1.4] font-semibold">
            {nextPost.data.title}
          </span>
        </a>
      </Card>
    ) : null
  }
</nav>
