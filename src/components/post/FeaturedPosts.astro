---
import type { CollectionEntry } from "astro:content";
import PostCard from "@/components/PostCard.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
// 大量精选只在首页展示前四篇，完整内容仍可通过全部文章访问。
const visiblePosts = posts.length >= 7 ? posts.slice(0, 4) : posts;
const bento = visiblePosts.length === 3;
---

{
  visiblePosts.length > 0 && (
    <ul
      data-featured-posts
      class:list={[
        "grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5",
        bento && "lg:auto-rows-fr lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]",
      ]}
    >
      {visiblePosts.map((post, index) => (
        <li
          class:list={[
            "min-w-0",
            bento && index === 0 && "md:col-span-2 lg:col-span-1 lg:row-span-2",
            !bento &&
              index === visiblePosts.length - 1 &&
              visiblePosts.length % 2 === 1 &&
              "md:col-span-2",
          ]}
        >
          <PostCard
            post={post}
            variant={
              index === 0 && (bento || visiblePosts.length === 1)
                ? "featured"
                : "compact"
            }
          />
        </li>
      ))}
    </ul>
  )
}
