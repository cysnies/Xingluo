---
import type { CollectionEntry } from "astro:content";
import PostCard from "@/components/PostCard.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
  priorityPostId?: string;
}

const { posts, priorityPostId } = Astro.props;
// 大量精选只在首页展示前四篇，完整内容仍可通过全部文章访问。
const visiblePosts = posts.length >= 7 ? posts.slice(0, 4) : posts;
const threeColumns = visiblePosts.length === 3;
---

{
  visiblePosts.length > 0 && (
    <ul
      data-featured-posts
      class:list={[
        "grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5",
        threeColumns && "lg:grid-cols-3",
      ]}
    >
      {visiblePosts.map((post, index) => (
        <li
          class:list={[
            "min-w-0",
            threeColumns && index === 2 && "md:col-span-2 lg:col-span-1",
            !threeColumns &&
              index === visiblePosts.length - 1 &&
              visiblePosts.length % 2 === 1 &&
              "md:col-span-2",
          ]}
        >
          <PostCard
            post={post}
            priority={post.id === priorityPostId}
            variant={
              threeColumns || visiblePosts.length === 1
                ? "featured"
                : "compact"
            }
          />
        </li>
      ))}
    </ul>
  )
}
