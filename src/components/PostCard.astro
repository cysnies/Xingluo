---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCardTags } from "@/utils/getPostCardTags";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations, tplStr } from "@/i18n";
import { getReadingTime } from "@/utils/readingTime";
import config from "@/config";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";
import Card from "@/components/ui/Card.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import { cn } from "@/lib/utils";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "featured" | "compact" | "list";
  showTags?: boolean;
  class?: string;
}

const {
  post,
  variant = "compact",
  showTags = true,
  class: className,
} = Astro.props;
const { data, id, filePath } = post;
const locale = Astro.currentLocale ?? config.site.lang;
const tr = useTranslations(locale);
const href = getPostUrl(id, filePath, locale);
const tags = getPostCardTags(data.tags, data.category);
const categoryName = data.category ?? "";
const categoryHref = categoryName
  ? getRelativeLocaleUrl(locale, `categories/${slugifyStr(categoryName)}/`)
  : undefined;
const readingMinutes = getReadingTime(post.body ?? "", locale);

// 沿用字符串和 Astro 图片对象两种内容格式。
const heroImage = config.features.showPostCardHero ? data.heroImage : undefined;
const heroImageSrc = typeof heroImage === "string" ? heroImage : heroImage?.src;
/** 所有带图文章卡片统一使用右侧背景式头图。 */
const useBackgroundHero = Boolean(heroImageSrc);
---

<Card
  as="article"
  data-post-card
  data-variant={variant}
  data-direction={config.site.dir}
  data-reveal
  class={cn(
    "post-card group relative h-full min-w-0 gap-0 overflow-hidden rounded-xl border-border/80 p-4 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs motion-reduce:transition-none md:p-6",
    variant === "featured" && "bg-muted/20",
    variant === "list" &&
      "rounded-none border-0 bg-transparent px-0 py-5 hover:shadow-none md:px-0 md:py-6",
    className,
  )}
>
  {
    useBackgroundHero && heroImageSrc && (
      <div
        data-post-card-image
        class={cn(
          "post-card__hero pointer-events-none absolute inset-y-0 end-0 w-[58%] bg-cover",
          config.features.showPostCardHeroMobile ? "block" : "hidden md:block",
        )}
        style={{ backgroundImage: `url("${heroImageSrc}")` }}
        aria-hidden="true"
      />
    )
  }

  <div
    class={cn(
      "relative z-10 flex min-w-0 flex-col gap-4 md:gap-5",
      variant !== "list" && "flex-1",
      variant !== "featured" && "md:flex-row",
      useBackgroundHero && "md:pe-[42%]",
    )}
  >
    <div
      class={cn(
        "min-w-0 flex-1",
        variant !== "list" && "flex flex-col",
      )}
    >
      <CardTitle
        transition:name={toTransitionName(data.title)}
        class={cn(
          "min-w-0 line-clamp-2 break-words text-xl leading-[1.4]",
          variant === "featured" && "md:text-2xl lg:text-[1.625rem]",
        )}
      >
        <a href={href} class="post-card__title-link">{data.title}</a>
      </CardTitle>

      <div
        data-post-card-meta
        class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-normal text-muted-foreground"
      >
        <Datetime
          pubDatetime={data.pubDatetime}
          modDatetime={data.modDatetime}
          timezone={data.timezone}
          compact
        />
        {
          config.features.showReadingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {tplStr(tr.post.readingTime, { minutes: readingMinutes })}
              </span>
            </>
          )
        }
      </div>

      {
        data.description && (
          <CardDescription
            class={cn(
              "mt-2 break-words text-sm leading-[1.65]",
              variant === "list" ? "line-clamp-2" : "line-clamp-3",
            )}
          >
            {data.description}
          </CardDescription>
        )
      }

      {
        showTags && (categoryHref || tags.visible.length > 0) && (
          <div
            data-post-card-taxonomy
            class={cn(
              "flex flex-wrap items-center gap-x-1 gap-y-0",
              variant === "list" ? "mt-3" : "mt-auto pt-3",
            )}
          >
            {categoryHref && (
              <a
                href={categoryHref}
                aria-label={tplStr(tr.post.categoryLabel, {
                  category: categoryName,
                })}
                class="relative z-10 inline-flex min-h-11 min-w-11 max-w-full items-center justify-center rounded-md px-1 transition-colors hover:bg-accent"
              >
                <span class="truncate rounded-md bg-muted px-2 py-1 text-xs leading-normal text-foreground">
                  {categoryName}
                </span>
              </a>
            )}
            {tags.visible.map((tag) => (
              <Tag
                tag={slugifyStr(tag)}
                tagName={tag}
                size="sm"
                showHash={false}
                class="relative z-10 min-h-11 min-w-11 justify-center text-xs leading-normal"
              />
            ))}
            {tags.hidden.length > 0 && (
              <span
                class="relative z-10 inline-flex min-h-11 items-center px-2 text-xs text-muted-foreground"
                title={tags.hidden.join(", ")}
                aria-label={`${tr.post.tagLabel} ${tags.hidden.join(", ")}`}
              >
                +{tags.hidden.length}
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
</Card>

<style>
  .post-card__hero {
    background-position: right center;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
  }

  .post-card[data-direction="rtl"] .post-card__hero {
    background-position: left center;
    mask-image: linear-gradient(
      to left,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to left,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
  }

  .post-card__title-link::after {
    position: absolute;
    inset: 0;
    content: "";
    border-radius: var(--radius-xl);
  }

  .post-card__title-link:focus-visible {
    outline: none;
  }

  :global(.post-card:has(.post-card__title-link:focus-visible)) {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
</style>
