---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCardTags } from "@/utils/getPostCardTags";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations, tplStr } from "@/i18n";
import { getReadingTime } from "@/utils/readingTime";
import config from "@/config";
import Datetime from "./Datetime.astro";
import Card from "@/components/ui/Card.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import PostCategory from "@/components/post/PostCategory.astro";
import PostTaxonomy from "@/components/post/PostTaxonomy.astro";
import { cn } from "@/lib/utils";
import { getPostHeroSources } from "@/utils/postHeroImage";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "featured" | "compact" | "list";
  density?: "default" | "compact";
  showTags?: boolean;
  priority?: boolean;
  class?: string;
}

const {
  post,
  variant = "compact",
  density = "default",
  showTags = true,
  priority = false,
  class: className,
} = Astro.props;
const { data, id, filePath } = post;
const locale = Astro.currentLocale ?? config.site.lang;
const tr = useTranslations(locale);
const href = getPostUrl(id, filePath, locale);
const tags = getPostCardTags(data.tags, data.category).visible;
const hasTags = tags.length > 0;
const readingMinutes = getReadingTime(post.body ?? "", locale);

// 沿用字符串和 Astro 图片对象两种内容格式。
const heroImage = config.features.showPostCardHero ? data.heroImage : undefined;
const optimizedHero =
  heroImage && typeof heroImage === "object"
    ? await getPostHeroSources(heroImage)
    : undefined;
const heroImageSrc =
  optimizedHero?.src ??
  (typeof heroImage === "string" ? heroImage : heroImage?.src);
/** 所有带图文章卡片统一使用右侧背景式头图。 */
const useBackgroundHero = Boolean(heroImageSrc);
---

<Card
  as="article"
  data-post-card
  data-variant={variant}
  data-direction={config.site.dir}
  data-reveal
  class={cn(
    "post-card group relative h-full min-w-0 gap-0 overflow-hidden rounded-xl border-border/80 p-4 shadow-none transition-[border-color,box-shadow] duration-200 hover:border-muted-foreground/50 hover:shadow-xs motion-reduce:transition-none md:p-6",
    density === "compact" && "md:p-5",
    variant === "featured" && "bg-muted/20",
    variant === "list" &&
      "rounded-none border-0 bg-transparent px-0 py-5 hover:shadow-none md:px-0 md:py-6",
    className,
  )}
>
  {
    useBackgroundHero && heroImageSrc && (
      <img
        data-post-card-image
        src={heroImageSrc}
        srcset={optimizedHero?.srcSet}
        sizes="(min-width: 768px) 58vw, 100vw"
        alt=""
        width={optimizedHero?.width ?? 1200}
        height={optimizedHero?.height ?? 630}
        loading={
          priority && config.features.showPostCardHeroMobile ? "eager" : "lazy"
        }
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
        class={cn(
          "post-card__hero pointer-events-none absolute inset-y-0 end-0 h-full w-[58%] object-cover",
          config.features.showPostCardHeroMobile ? "block" : "hidden md:block",
        )}
        aria-hidden="true"
      />
    )
  }

  <div
    class={cn(
      "relative z-10 flex min-w-0 flex-col gap-4 md:gap-5",
      density === "compact" && "gap-3 md:gap-4",
      variant !== "list" && "flex-1",
      variant !== "featured" && "md:flex-row",
      useBackgroundHero && "md:pe-[42%]",
    )}
  >
    <div
      class={cn(
        "min-w-0 flex-1",
        variant !== "list" && "flex flex-col",
      )}
    >
      <CardTitle
        transition:name={toTransitionName(data.title)}
        class={cn(
          "min-w-0 line-clamp-2 break-words text-xl leading-[1.4]",
          density === "compact" && "text-lg",
          variant === "featured" && "md:text-2xl lg:text-[1.625rem]",
        )}
      >
        <a href={href} class="post-card__title-link">{data.title}</a>
      </CardTitle>

      <div
        data-post-card-meta
        class={cn(
          "mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-normal text-muted-foreground",
          density === "compact" && "mt-1.5",
        )}
      >
        <PostCategory category={data.category} />
        {data.category && <span aria-hidden="true">·</span>}
        <Datetime
          pubDatetime={data.pubDatetime}
          modDatetime={data.modDatetime}
          timezone={data.timezone}
          compact
        />
        {
          config.features.showReadingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {tplStr(tr.post.readingTime, { minutes: readingMinutes })}
              </span>
            </>
          )
        }
      </div>

      {
        data.description && (
          <CardDescription
            class={cn(
              "mt-2 break-words text-sm leading-[1.65]",
              density === "compact" && "mt-1.5 text-xs",
              variant === "list" ? "line-clamp-2" : "line-clamp-3",
            )}
          >
            {data.description}
          </CardDescription>
        )
      }

      {
        showTags && hasTags && (
          <div
            class={cn(
              variant === "list" ? "mt-3" : "mt-auto pt-3",
              density === "compact" && "pt-2",
            )}
          >
            <PostTaxonomy tags={tags} />
          </div>
        )
      }
    </div>
  </div>
</Card>

<style>
  .post-card__hero {
    object-position: right center;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
  }

  .post-card[data-direction="rtl"] .post-card__hero {
    object-position: left center;
    mask-image: linear-gradient(
      to left,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to left,
      transparent 0%,
      rgb(0 0 0 / 0.08) 12%,
      black 38%,
      black 100%
    );
  }

  .post-card__title-link::after {
    position: absolute;
    inset: 0;
    content: "";
    border-radius: var(--radius-xl);
  }

  .post-card__title-link:focus-visible {
    outline: none;
  }

  :global(.post-card:has(.post-card__title-link:focus-visible)) {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
</style>
