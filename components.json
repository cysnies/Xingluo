{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": false,
  "tailwind": {
    "config": "",
    "css": "src/styles/global.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide",
  "xingluo": {
    "note": "本主题为 Astro 原生 UI（无 React）。components.json 用于对齐 shadcn new-york / Zinc 基色 / CSS 变量约定；新增组件请用手写 .astro 或 Starwind，勿直接 npx shadcn 添加 React 组件。",
    "tokens": "src/styles/theme.css",
    "compat": "src/styles/shadcn-compat.css",
    "palettes": "src/styles/palettes.css"
  }
}
