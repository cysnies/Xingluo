{
  "name": "xingluo",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "星罗 - 基于 Astro 与 shadcn 视觉风格的现代化博客主题",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/checkAssets.mjs && astro check && astro build && node scripts/generatePagefindIndex.mjs && node scripts/cleanOrphanAssets.mjs && node scripts/budget.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:assets": "node scripts/checkAssets.mjs",
    "budget": "node scripts/budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@waline/client": "^3.15.2",
    "aplayer": "^1.10.1",
    "astro": "^6.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dplayer": "^1.27.1",
    "rehype-callouts": "^2.1.2",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "twikoo": "^1.7.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/parser": "^8.60.0",
    "astro-icon": "^1.1.5",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "pagefind": "1.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "3.2.4"
  }
}
